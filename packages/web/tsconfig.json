{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],

    // Vite produces the actual bundle. tsc is here only to typecheck, but a
    // composite project may not disable emit, so it emits declarations into a
    // throwaway directory instead.
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../core" }]
}
