# --- API ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins, or * to allow any.
CORS_ORIGIN=http://localhost:5173

# --- Stream resolution ---
# Path to the yt-dlp binary. When it is missing the API answers from the demo
# catalogue and reports { ytDlp: false } on /api/health.
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=20000

# --- Lyrics ---
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_TIMEOUT_MS=6000

# Unofficial NetEase Cloud Music web API, tried as a fallback when LRCLIB has
# no lyrics. No key/token needed; treat as best-effort (undocumented API).
NETEASE_BASE_URL=https://music.163.com
NETEASE_TIMEOUT_MS=6000

# Musixmatch (unofficial desktop API) — the widest synced-lyrics source, tried
# for songs LRCLIB doesn't have. No paid key: an anonymous user token is fetched
# and cached automatically. Set MUSIXMATCH_ENABLED=0 to turn it off, or supply
# your own token to skip the (rate-limited) token endpoint. Undocumented API —
# best-effort, and the source silently no-ops if it stops responding.
MUSIXMATCH_ENABLED=true
MUSIXMATCH_BASE_URL=https://apic-desktop.musixmatch.com
MUSIXMATCH_USERTOKEN=
MUSIXMATCH_TIMEOUT_MS=8000

# For the long tail of providers (Megalobiz, Genius, …) you can later shell out
# to the `syncedlyrics` Python CLI (pip install syncedlyrics) the same way the
# app already calls yt-dlp. Not wired up yet — the native sources above cover the
# common cases.

# --- AI (Google Gemini, free tier) ---
# Enables real line translation (whole track on load) and the AI lyric
# assistant. Leave GEMINI_API_KEY empty to keep both disabled — translations
# fall back to the "no translation" placeholder and the assistant returns its
# local placeholder draft. /api/health reports { gemini: <bool> }.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=15000
# ISO code translations are rendered into (en, de, fr, es, it, zh, ...).
TRANSLATE_TARGET_LANG=en

# --- Serving the built client from the API process ---
SERVE_CLIENT=false
CLIENT_DIR=../client/dist

# Where saved words, lines and clips are written.
DATA_DIR=./.data
