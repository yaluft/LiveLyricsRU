# --- API ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins, or * to allow any.
CORS_ORIGIN=http://localhost:5173

# --- Stream resolution ---
# Path to the yt-dlp binary. When it is missing the API answers from the demo
# catalogue and reports { ytDlp: false } on /api/health.
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=20000

# Optional: absolute path to a Netscape-format cookies.txt for yt-dlp (needed
# for age-restricted or login-gated videos). Leave unset — the safe default —
# to skip cookies entirely. Only takes effect if the path is a real file; a
# Docker bind mount of a missing host file becomes an empty directory here
# and is intentionally ignored.
# YT_DLP_COOKIES_PATH=/app/cookies.txt

# --- Lyrics ---
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_TIMEOUT_MS=6000

# Unofficial NetEase Cloud Music web API, tried as a fallback when LRCLIB has
# no lyrics. No key/token needed; treat as best-effort (undocumented API).
NETEASE_BASE_URL=https://music.163.com
NETEASE_TIMEOUT_MS=6000

# --- Serving the built client from the API process ---
SERVE_CLIENT=false
CLIENT_DIR=../client/dist

# Where saved words, lines and clips are written.
DATA_DIR=./.data
