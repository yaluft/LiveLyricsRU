# Every variable here has a working default — the app runs with no .env at all.

# --- API ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Storage ---
DATA_DIR=./.data
# DATABASE_URL=file:./.data/lyrika.db
# Built by `npm run build:dictionary`. Absent is supported: word lookups then
# return a romanisation only, exactly as they do for an unknown word.
# DICTIONARY_PATH=./.data/dictionary.db
MAX_UPLOAD_BYTES=67108864

# --- Stream resolution (optional) ---
# Without yt-dlp on PATH, search and URL resolution are unavailable and upload
# is the working path. The app does not hard-fail.
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=20000
# Netscape-format cookie file, for when YouTube demands a signed-in session.
# YT_DLP_COOKIES=./cookies.txt

# --- Lyrics ---
LRCLIB_BASE_URL=https://lrclib.net
LYRICS_TIMEOUT_MS=6000

# --- Translation (optional) ---
# Absent key is a supported state: the UI hides the translation row rather than
# printing "unavailable" under every line, which is what v2 did.
# ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-sonnet-5

# --- Single-container serving ---
SERVE_CLIENT=false
CLIENT_DIR=../web/dist
