{
  "name": "lyrika",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -n core,server,web -c cyan,magenta,green \"npm:dev:core\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:core": "npm run dev -w @lyrika/core",
    "dev:server": "npm run dev -w @lyrika/server",
    "dev:web": "npm run dev -w @lyrika/web",
    "build": "tsc --build && npm run build -w @lyrika/web",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "//pretest:e2e": "The dev server imports @lyrika/core from its dist, which nothing else in the e2e path builds. Without this the suite passes locally on a warm dist and fails everywhere else.",
    "pretest:e2e": "tsc --build",
    "test:e2e": "playwright test",
    "start": "node packages/server/dist/index.js",
    "build:dictionary": "npm run build -w @lyrika/build-dictionary && node tools/build-dictionary/dist/index.js",
    "clean": "tsc --build --clean && rm -rf packages/web/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-solid": "^0.14.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
