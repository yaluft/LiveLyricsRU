{
  // v2 excluded test files from tsconfig entirely, so `npm run typecheck` never
  // looked at them. This project typechecks them explicitly — no emit, so it
  // needs no place in the composite reference graph.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "types": ["node"]
  },
  // Only the Node packages. packages/web's own tsconfig has no `exclude`, so it
  // already typechecks its `.test.tsx` files with the JSX and DOM settings they
  // need — matching them here as well would check them a second time under a
  // Node config that has neither.
  "include": ["packages/core/src/**/*.test.ts", "packages/server/src/**/*.test.ts"]
}
